[tool.usecli]
title = "{{ title | default('My CLI') }}"
title_file = "{{ title_file | default('') }}"
title_font = "{{ title_font | default('big') }}"
description = "{{ description | default('A custom CLI tool') }}"
commands_dir = "{{ commands_dir | default('cli/commands') }}"
templates_dir = "{{ templates_dir | default('cli/templates') }}"
hide_init = {{ hide_init | default(false) | lower }}
hide_inspire = {{ hide_inspire | default(false) | lower }}
hide_make_command = {{ hide_make_command | default(false) | lower }}
