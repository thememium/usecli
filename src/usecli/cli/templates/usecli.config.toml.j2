# Runtime configuration for {{ command_name | default('usecli') }}.
# Paths are relative to this file.

[usecli]
command_name = "{{ command_name | default('usecli') }}"
title = "{{ title | default('My CLI') }}"
description = "{{ description | default('A custom CLI tool') }}"

[usecli.paths]
commands = "{{ commands_dir | default('cli/commands') }}"
templates = "{{ templates_dir | default('cli/templates') }}"
# One directory or a list of directories; the first is where `make:theme`
# writes new themes.
themes = ["{{ themes_dir | default('cli/themes') }}"]
# Bundled Agent Skills; each subdirectory contains a SKILL.md.
skills = "{{ skills_dir | default('cli/skills') }}"

[usecli.theme]
# Theme TOML file to load, by name or path.
name = "{{ theme | default('default') }}"

[usecli.banner]
# Optional: a text file whose contents replace the rendered title.
# Relative paths resolve against the project root.
# file = "cli/title.txt"
{% if title_file %}file = "{{ title_file }}"
{% endif %}# Optional: a figlet font for the title (requires the `figlet` extra).
# font = "big"
{% if title_font %}font = "{{ title_font }}"
{% endif %}top_space = {{ title_extra_top_space | default(true) | lower }}
bottom_space = {{ title_extra_bottom_space | default(true) | lower }}
# Whether the version and description follow the title.
show_version = {{ show_version | default(true) | lower }}
show_description = {{ show_description | default(true) | lower }}

[usecli.options]
# Built-in root options to leave unregistered for this project's CLI, for
# example ["interactive", "json", "install-skills"]. "interactive" and "json"
# apply to every command and command group; the others are root-only. The
# `usecli` framework binary ignores this list; --help/-h is always available.
hidden = []

[usecli.commands]
# Built-in commands to leave unregistered for this project's CLI,
# for example ["inspire"]. The `usecli` framework binary always exposes
# its own built-in commands.
hidden = []
# How to expose skill installation: "option" shows --install-skills in the
# root options; "command" shows skill:install under a `skill:` section.
# "none" hides both so you can provide your own installer.
skill_install = "option"

[usecli.upgrade]
enabled = {{ upgrade_enabled | default(true) | lower }}
# Where upgrades come from: "auto" (detect from install metadata), "pypi", or "git".
source = "{{ upgrade_source | default('auto') }}"
# Git only: repository URL. Falls back to the URL in the install metadata.
# url = "https://github.com/owner/repo.git"
# Optional: distribution name and Git ref (branch, tag, or commit) overrides.
# package = "my-cli"
# ref = "main"
